# Copy to .env.local for local development. Never commit .env.local.
# On Vercel these are set in Project Settings > Environment Variables
# (the Neon integration adds DATABASE_URL for you).

# Neon: use the pooled connection string
DATABASE_URL=

# Clerk: from the Clerk dashboard, API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
